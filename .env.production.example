# Copy to .env on the future Linux server; replace the example domain.
DOMAIN=pnp.example.com
NODE_ENV=production
PUBLIC_BASE_URL=https://pnp.example.com
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
BACKUP_DIR=/app/backups
SECURE_COOKIE=1
# Dedicated Caddy container address in compose.yaml. Do not use '*'.
TRUSTED_PROXIES=172.30.87.2
# No default passwords, API keys or signing secrets are required.
# Accounts are created interactively; sessions use random server-side tokens.
