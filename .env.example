# Optional for local Windows/Linux operation. Copy to .env only if needed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
BACKUP_DIR=./backups
# Empty locally; production requires your real HTTPS origin, without a path.
PUBLIC_BASE_URL=
SECURE_COOKIE=0
# Exact proxy IPs, comma separated. Empty means ignore all forwarded headers.
TRUSTED_PROXIES=
